              "name": "fmt",
              "value": "json"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "816fe09f-474a-4c48-9ef9-76b27dca2d5a",
      "onError": "continueRegularOutput"
    },
    {
      "name": "Normalize Dividends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One item per stock (fullResponse keeps array bodies from splitting).\n// A non-200 or non-array body degrades to zero rows for that stock —\n// never fails the whole import.\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  let stock;\n  try { stock = $('Loop Over Stocks (Batch)').itemMatching(i).json; } catch (e) { continue; }\n  const resp = items[i].json || {};\n  const body = (resp.statusCode === 200 && Array.isArray(resp.body)) ? resp.body : [];\n  const rows = body.filter((d) => d && d.date && !isNaN(Date.parse(d.date)));\n  out.push({ json: {\n    stockId: stock.id,\n    symbol: stock.symbol,\n    divCount: rows.length,\n    divsJson: JSON.stringify(rows.map((d) => ({ date: d.date, value: d.value, unadjustedValue: d.unadjustedValue, currency: d.currency }))),\n  } });\n}\nreturn out;"
      },
      "id": "4eadd6f4-ff34-4309-bfde-17e36d2cba02"
    },
    {
      "name": "Upsert Dividends",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1120,
        272
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO dividends (stock_id, ex_date, value, unadjusted_value, currency)\nSELECT $1,\n       (e->>'date')::date,\n       NULLIF(e->>'value', '')::numeric,\n       NULLIF(e->>'unadjustedValue', '')::numeric,\n       NULLIF(e->>'currency', '')\nFROM jsonb_array_elements($2::jsonb) e\nON CONFLICT (stock_id, ex_date) DO UPDATE SET\n  value = EXCLUDED.value,\n  unadjusted_value = EXCLUDED.unadjusted_value,\n  currency = EXCLUDED.currency;",
        "options": {
          "queryReplacement": "={{ [$json.stockId, $json.divsJson] }}"
        }
      },
      "id": "ca4524f3-4c70-4493-a719-4f34f7acb410",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "name": "Loop Over Stocks (Batch)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
