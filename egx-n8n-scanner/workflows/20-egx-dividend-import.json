        192
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MARKET_API_BASE_URL }}/div/{{ $json.symbol }}.EGX",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "api_token",
              "value": "={{ $env.MARKET_API_KEY }}"
            },
