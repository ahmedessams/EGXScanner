    {
      "name": "Aggregate Backtest Metrics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  COUNT(*)::float8 AS sample_size,\n  ROUND(AVG(CASE WHEN pe.return_previous_close_to_close_pct > 0 THEN 1 ELSE 0 END) * 100, 2)::float8 AS positive_close_rate_pct,\n  ROUND(AVG(pe.return_previous_close_to_close_pct)::numeric, 4)::float8 AS avg_return_pct,\n  ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY pe.return_previous_close_to_close_pct))::numeric, 4)::float8 AS median_return_pct,\n  ROUND(AVG(pe.maximum_favorable_excursion_pct)::numeric, 4)::float8 AS avg_mfe_pct,\n  ROUND(AVG(pe.maximum_adverse_excursion_pct)::numeric, 4)::float8 AS avg_mae_pct,\n  ROUND(AVG(CASE WHEN pe.target1_hit THEN 1 ELSE 0 END) * 100, 2)::float8 AS target1_hit_rate_pct,\n  ROUND(AVG(CASE WHEN pe.target2_hit THEN 1 ELSE 0 END) * 100, 2)::float8 AS target2_hit_rate_pct,\n  ROUND(AVG(CASE WHEN pe.stop_hit THEN 1 ELSE 0 END) * 100, 2)::float8 AS stop_hit_rate_pct\nFROM prediction_evaluation pe\nJOIN scanner_results r ON r.id = pe.scanner_result_id\nJOIN scanner_runs run ON run.id = r.scanner_run_id\nWHERE run.run_type = 'BACKTEST'\n  AND run.trading_date BETWEEN $1 AND $2\n  AND r.overall_score >= $3\n  AND r.eligible = TRUE\n  AND ($4 = 'ANY' OR r.setup_type = $4)\n  AND r.overall_rank <= $5;",
        "options": {
          "queryReplacement": "={{ [\n  $('Resolve Backtest Parameters').first().json.startDate,\n  $('Resolve Backtest Parameters').first().json.endDate,\n  $('Resolve Backtest Parameters').first().json.minimumScore,\n  $('Resolve Backtest Parameters').first().json.setupType,\n  $('Resolve Backtest Parameters').first().json.topN\n] }}"
        }
      },
      "executeOnce": true,
      "position": [
        780,
        400
      ],
      "id": "1131030f-f56d-412b-b18f-e9913e2c7902"
    },
    {
      "name": "Build Backtest Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const params = $('Resolve Backtest Parameters').first().json;\nconst metrics = $input.first().json;\nreturn [{ json: {\n  workflow: '15-egx-backtest',\n  finishedAt: new Date().toISOString(),\n  parameters: params,\n  metrics: {\n    sampleSize: Number(metrics.sample_size) || 0,\n    positiveCloseRatePct: metrics.positive_close_rate_pct,\n    avgReturnPct: metrics.avg_return_pct,\n    medianReturnPct: metrics.median_return_pct,\n    avgMfePct: metrics.avg_mfe_pct,\n    avgMaePct: metrics.avg_mae_pct,\n    target1HitRatePct: metrics.target1_hit_rate_pct,\n    target2HitRatePct: metrics.target2_hit_rate_pct,\n    stopHitRatePct: metrics.stop_hit_rate_pct,\n  },\n  disclaimer: 'Historical Probability derived from simulated point-in-time scans. Past performance does not guarantee future results.',\n} }];"
      },
      "position": [
        1040,
        400
      ],
      "id": "f2ee9bc4-210b-4121-ad65-03535e6138f7"
    }
