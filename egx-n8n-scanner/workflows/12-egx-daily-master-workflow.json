    {
      "name": "Compute Trading Date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "let trigger = {};\ntry {\n  const triggerItems = $('When Executed by Another Workflow').all();\n  trigger = triggerItems.length ? triggerItems[0].json : {};\n} catch (e) { trigger = {}; }\n// Immediate input is the fallback for BOTH fields: the US schedule branch\n// attaches {market, asOfDate} via a Code node, and sub-workflow callers'\n// items also arrive here as $input even when the named-trigger lookup\n// returns nothing (observed live 2026-08-23: market arrived via $input\n// while trigger.asOfDate stayed undefined and wrongly defaulted to today).\nconst immediate = ($input.first() && $input.first().json) || {};\nconst asOfDate = trigger.asOfDate || immediate.asOfDate || new Date().toISOString().slice(0, 10);\nconst market = trigger.market || immediate.market || 'EGX';\nreturn [{ json: { asOfDate, market } }];"
      },
      "position": [
        528,
