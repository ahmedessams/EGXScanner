    {
      "name": "Load Report Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  run.trading_date::text AS trading_date, run.market_score::float8 AS market_score, run.market_regime,\n  run.stocks_scanned::float8 AS stocks_scanned, run.eligible_stocks::float8 AS eligible_stocks,\n  (SELECT json_agg(top.* ORDER BY top.overall_rank ASC) FROM (\n    SELECT r.overall_rank, s.symbol, s.name, r.overall_score, r.setup_type,\n           r.entry_price, r.invalidation_price, r.target1, r.target2, r.risk_reward_t2,\n           ta.rsi14, sr.support1, sr.resistance1, va.relative_volume20_rank,\n           ta.relative_volume20 AS rvol20\n    FROM scanner_results r\n    JOIN stocks s ON s.id = r.stock_id\n    LEFT JOIN technical_analysis ta ON ta.stock_id = r.stock_id AND ta.trading_date = run.trading_date\n    LEFT JOIN support_resistance sr ON sr.stock_id = r.stock_id AND sr.trading_date = run.trading_date\n    LEFT JOIN volume_analysis va ON va.stock_id = r.stock_id AND va.trading_date = run.trading_date\n    WHERE r.scanner_run_id = run.id AND r.eligible = TRUE\n    ORDER BY r.overall_rank ASC LIMIT 10\n  ) top) AS top10\nFROM scanner_runs run WHERE run.id = $1;",
        "options": {
          "queryReplacement": "={{ [$json.scannerRunId] }}"
        }
      },
      "executeOnce": true,
      "position": [
        520,
        400
      ],
      "id": "3513f32d-0f2d-467b-baaa-40bc36c72838"
    },
    {
      "name": "Generate Daily Report Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const row = $input.first().json;\nconst top10 = row.top10 || [];\n\nconst lines = [];\nlines.push('EGX DAILY SCANNER');\nlines.push('Trading Date: ' + row.trading_date);\nlines.push('');\nlines.push('MARKET');\nlines.push('--------------------------------');\nlines.push('Market Regime: ' + row.market_regime);\nlines.push('Market Score: ' + row.market_score + '/100');\nlines.push('Stocks Scanned: ' + row.stocks_scanned);\nlines.push('Eligible Stocks: ' + row.eligible_stocks);\nlines.push('');\nlines.push('OVERALL TOP 10 (Bullish Setup Score)');\nlines.push('--------------------------------');\n\nif (!top10.length) {\n  lines.push('No eligible stocks scored above the ranking threshold today.');\n} else {\n  for (const t of top10) {\n    lines.push(`${t.overall_rank}. ${t.symbol} - ${t.name}`);\n    lines.push(`   Score: ${t.overall_score}  Setup: ${t.setup_type}  RVOL: ${t.rvol20 ?? 'n/a'}x  RSI: ${t.rsi14 ?? 'n/a'}`);\n    lines.push(`   Support: ${t.support1 ?? 'n/a'}  Resistance: ${t.resistance1 ?? 'n/a'}`);\n    lines.push(`   Entry Trigger: ${t.entry_price ?? 'n/a'}  Invalidation: ${t.invalidation_price ?? 'n/a'}`);\n    lines.push(`   Target 1: ${t.target1 ?? 'n/a'}  Target 2: ${t.target2 ?? 'n/a'}  R:R T2: ${t.risk_reward_t2 ?? 'n/a'}`);\n    lines.push('');\n  }\n}\n\nlines.push('This is a quantitative Scanner Rank based on Historical Probability, not a');\nlines.push('guaranteed prediction. See docs/SCORING.md for methodology.');\n\nreturn [{ json: {\n  workflow: '12-egx-daily-master-workflow',\n  finishedAt: new Date().toISOString(),\n  tradingDate: row.trading_date,\n  marketRegime: row.market_regime,\n  marketScore: row.market_score,\n  top10Count: top10.length,\n  reportText: lines.join('\\n'),\n} }];"
      },
      "position": [
        780,
        400
      ],
      "id": "1ae65e58-e5fa-4f28-a5b8-3437dbaf1171"
    }
