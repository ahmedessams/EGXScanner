      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The US session date, NOT the current UTC/Cairo date: this trigger fires\n// at 03:00 Cairo = 00:00 UTC, when the UTC calendar has already rolled to\n// the day AFTER the session being scanned. Using the current date in\n// America/New_York (20:00 ET on session day) yields the session's own\n// date. Without this, every nightly US scan looked for prices dated\n// 'tomorrow', found none, and silently skipped as a non-trading day\n// (confirmed live: execution 839 on 2026-08-21 'succeeded' but scanned\n// nothing).\nconst asOfDate = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });\nreturn [{ json: { market: 'US', asOfDate } }];"
      },
      "id": "422e3940-e76c-415a-8add-590f490508fc"
