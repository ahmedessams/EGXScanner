    {
      "name": "Compute Trading Date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Same defensive try/catch as every other workflow's trigger-lookup code\n// (see scannerCommon.js attachAsOfDateNode) — reading a trigger node that\n// never fired throws in this n8n version. Schedule/Manual paths carry no\n// market, so they keep today's exact EGX-only behavior; only an explicit\n// Execute Workflow call (Phase 3's per-market schedules, or manual testing\n// via MCP) can select a different market.\nlet trigger = {};\ntry {\n  const triggerItems = $('When Executed by Another Workflow').all();\n  trigger = triggerItems.length ? triggerItems[0].json : {};\n} catch (e) { trigger = {}; }\nconst market = trigger.market || 'EGX';\nreturn [{ json: { asOfDate: new Date().toISOString().slice(0, 10), market } }];"
      },
