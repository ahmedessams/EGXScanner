# n8n, plus a Postgres client so the Render preDeployCommand can apply
# sql/*.sql and restore data/full_dump.sql.gz against the managed database
# before n8n starts. Local docker-compose usage doesn't need this image —
# it uses the stock n8nio/n8n:latest image directly.
FROM n8nio/n8n:latest

USER root
RUN apk add --no-cache postgresql-client

COPY sql/ /home/node/sql/
COPY data/ /home/node/data/
COPY scripts/render-db-init.sh /home/node/render-db-init.sh
RUN chmod +x /home/node/render-db-init.sh \
    && chown -R node:node /home/node/sql /home/node/data /home/node/render-db-init.sh

USER node
WORKDIR /home/node
